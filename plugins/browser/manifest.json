{
  "manifest_version": 3,
  "name": "Recall AI",
  "version": "0.1.0",
  "description": "Save pages and selections to Recall AI, and find them from the toolbar.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://recallai.nidonic.online/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Recall AI"
  },
  "options_page": "options.html",
  "commands": {
    "save-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save this page to Recall"
    }
  },
  "author": "Nidonic Labs"
}